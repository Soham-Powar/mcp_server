# Copy to .env and adjust as needed. All values have sensible defaults.

# --- Databases ------------------------------------------------------------
# Absolute or repo-relative paths to the SQLite files (one per MCP server).
UPI_DB_PATH=database/upi.db
IMPS_DB_PATH=database/imps.db

# --- LLM provider ---------------------------------------------------------
# ollama (default) | openai | anthropic  (only ollama is implemented in v1)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
DEFAULT_MODEL=qwen3

# Future providers (unused in v1):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Backend --------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MCP servers ----------------------------------------------------------
# How the backend spawns the default UPI MCP server (stdio transport).
MCP_SERVER_CMD=python
# MCP_SERVER_SCRIPT defaults to ./upi_server/server.py

# Connect to MANY MCP servers by overriding the whole list (JSON array).
# `name` must be unique and must not contain "__" (used to namespace tools).
# `description` is what the router LLM reads to pick a server.
# MCP_SERVERS=[{"name":"upi","command":"python","script":"upi_server/server.py","description":"UPI payment analytics"},{"name":"imps","command":"python","script":"imps_server/server.py","description":"IMPS transfer analytics"}]

# --- Router (LLM #1) ------------------------------------------------------
# Classifies each question to the relevant server(s) before the main model
# runs tool-calling. Auto-skipped when there is only one server.
ROUTER_ENABLED=true
# Small/fast model for routing. Defaults to gemma4:e2b (pull it first:
#   ollama pull gemma4:e2b). The router only needs to return a JSON array,
# so a tiny edge model is ideal here.
ROUTER_MODEL=gemma4:e2b
